# Profil Chrome dédié au scraper : 179 Mo, et il se reconstruit tout seul (au
# prix d'un nouveau challenge Cloudflare à passer).
.chrome-profile/

# Cache disque des pages et des réponses JSON : tout se retélécharge.
cache/

# Sorties générées par build_console.py et build_json.py.
# `index.html` et son `index.data.json` font exception : c'est ce qui est publié
# sur GitHub Pages (voir la section « Publication » du README). Le fichier de
# données porte le nom de sa page, pour qu'un build local n'écrase pas le publié.
console.html
console.data.json
output/

__pycache__/
*.pyc

# Captures produites par shoot.py : elles ne sont pas de la donnée du projet.
captures/

# Journal du rafraîchissement de 8 h : une trace d'exécution locale, qui
# grossirait d'une dizaine de lignes par jour dans l'historique pour rien.
daily.log
