# Profil Chrome dédié au scraper : 179 Mo, et il se reconstruit tout seul (au
# prix d'un nouveau challenge Cloudflare à passer).
.chrome-profile/

# Cache disque des pages et des réponses JSON : tout se retélécharge.
cache/

# Sorties générées par build_console.py et build_json.py.
# `console.html` reste l'OUTIL interne : un fichier unique, autonome, avec le
# générateur de brief Instagram. Ce qui est publié, c'est le site — ses pages
# sont versionnées, et ses données vivent dans `data/site.json`.
console.html
console.data.json
index.data.json
output/

__pycache__/
*.pyc

# Captures produites par shoot.py : elles ne sont pas de la donnée du projet.
captures/

# Journal du rafraîchissement de 8 h : une trace d'exécution locale, qui
# grossirait d'une dizaine de lignes par jour dans l'historique pour rien.
daily.log

# Captures des compositions envoyées par les clubs : pièces justificatives,
# pas de la donnée. Ce qui compte est extrait dans data/lineups.json, qui
# porte la provenance. Le LISEZ-MOI du dossier, lui, est versionné.
data/lineups/inbox/*
!data/lineups/inbox/LISEZ-MOI.txt
